# ============================================================
# vendedor-ia — Variables de entorno
# ============================================================
# Copiar este archivo como .env y completar los valores.
# Nunca commitear .env al repositorio.
#
# Iniciar el servidor:
#   node --env-file .env --import tsx/esm src/api/routes.ts
#
# O con el script de desarrollo (con watch):
#   npm run dev
# ============================================================

# ------------------------------------------------------------
# Supabase
# Obtener en: https://supabase.com/dashboard → Settings → API
# Usar la SERVICE KEY (service_role), NO la anon key.
# La service key bypasea RLS — solo usar en el servidor.
# ------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# Proveedor LLM — 'anthropic' (default) o 'gemini'
# ------------------------------------------------------------
LLM_PROVIDER=anthropic

# ------------------------------------------------------------
# Anthropic — Claude  (si LLM_PROVIDER=anthropic)
# Obtener en: https://console.anthropic.com/settings/keys
# Modelos: claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5 (más barato)
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...
AGENT_MODEL=claude-haiku-4-5

# ------------------------------------------------------------
# Google Gemini  (si LLM_PROVIDER=gemini) — más barato, con free tier
# Obtener key gratis en: https://aistudio.google.com/apikey
# Modelos: gemini-flash-latest (alias estable) | gemini-3.6-flash
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------
# Embeddings (RAG) — modelo LOCAL, sin API key ni costo.
# Se descarga una vez (~120 MB) y corre offline sobre CPU.
# Requiere aplicar la migración 005 (vector de 384 dim).
# ------------------------------------------------------------
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# ------------------------------------------------------------
# Precios en vivo — ERP GreatPhones (Google Apps Script web app)
# Fuente de verdad para contado, preventa y tabla de toma (canje).
# El endpoint es {url}?api=all&token={token} → JSON.
# Deploy: "Nueva versión" para que la URL no cambie · acceso "Cualquiera".
# ------------------------------------------------------------
PRICING_API_URL=https://script.google.com/macros/s/XXXX/exec
PRICING_API_TOKEN=gp_xxxxxxxxxxxxxxxxxxxx
PRICING_CACHE_TTL_MINUTES=10

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------
# Caché de business_rules
# TTL en minutos para el caché en proceso de la tabla business_rules.
# Cambios en la tabla se reflejan después de este tiempo (o con restart).
# ------------------------------------------------------------
BUSINESS_RULES_CACHE_TTL_MINUTES=60

# ------------------------------------------------------------
# API Auth (pendiente — agregar antes de exponer al exterior)
# En V1 la API no tiene autenticación. Antes de producción:
#   1. Agregar API_KEY aquí
#   2. Verificar en el middleware de routes.ts
#   3. Configurar HTTPS / proxy inverso
# ------------------------------------------------------------
# API_KEY=tu-api-key-secreta

# ============================================================
# KOMMO CRM — Integración de mensajes
# ============================================================
# Configurar en Kommo: Settings → Integrations → API keys
#
# 1. Obtener client_id y client_secret al crear la integración en Kommo
# 2. Completar el flujo OAuth una vez para obtener access/refresh tokens
# 3. Los tokens se renuevan automáticamente (no editar manualmente)
# ============================================================

# ------------------------------------------------------------
# Kommo — Autenticación OAuth 2.0
# Obtener en: https://www.kommo.com/developers/ → My integrations
# ------------------------------------------------------------
KOMMO_SUBDOMAIN=greatphones
KOMMO_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KOMMO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KOMMO_REDIRECT_URI=https://tu-servidor.com/kommo/oauth/callback
KOMMO_ACCESS_TOKEN=eyJ...
KOMMO_REFRESH_TOKEN=def50200...
# Unix timestamp de expiración del access token (se actualiza automáticamente)
KOMMO_TOKEN_EXPIRES_AT=1700000000

# ------------------------------------------------------------
# Kommo — Seguridad del webhook
# Configurar en Kommo al crear el webhook. Kommo enviará este
# secret en el header X-Signature de cada webhook.
# Si no se configura, la verificación de firma se desactiva (solo dev).
# ------------------------------------------------------------
KOMMO_WEBHOOK_SECRET=tu-webhook-secret-aleatorio

# ------------------------------------------------------------
# Kommo — Usuario responsable por defecto
# ID del usuario de Kommo al que se asignan las tareas automáticas
# (escalaciones, followups). Obtener en Kommo → Settings → Users
# ------------------------------------------------------------
KOMMO_DEFAULT_RESPONSIBLE_USER_ID=123456

# ------------------------------------------------------------
# Kommo — IDs de pipelines
# Obtener los IDs en Kommo → Settings → Pipelines
# Cada pipeline corresponde a un tipo de consulta de GreatPhones
# ------------------------------------------------------------
KOMMO_PIPELINE_COMPRA_ID=100001
KOMMO_PIPELINE_VENTA_ID=100002
KOMMO_PIPELINE_PERMUTA_ID=100003
KOMMO_PIPELINE_REPARACION_ID=100004
KOMMO_PIPELINE_GARANTIA_ID=100005
KOMMO_PIPELINE_ACCESORIOS_ID=100006

# ------------------------------------------------------------
# Kommo — IDs de etapas del pipeline COMPRA
# Obtener los IDs en Kommo → Settings → Pipelines → editar pipeline
# ------------------------------------------------------------
KOMMO_STAGE_COMPRA_NUEVO=200001
KOMMO_STAGE_COMPRA_CALIFICANDO=200002
KOMMO_STAGE_COMPRA_PRESUPUESTO=200003
KOMMO_STAGE_COMPRA_NEGOCIANDO=200004
KOMMO_STAGE_COMPRA_RESERVADO=200005
KOMMO_STAGE_COMPRA_PAGANDO=200006
KOMMO_STAGE_COMPRA_VENDIDO=200007
KOMMO_STAGE_COMPRA_PERDIDO=200008

# ------------------------------------------------------------
# Kommo — IDs de etapas del pipeline VENTA
# ------------------------------------------------------------
KOMMO_STAGE_VENTA_CONSULTA=201001
KOMMO_STAGE_VENTA_EVALUANDO=201002
KOMMO_STAGE_VENTA_COTIZACION=201003
KOMMO_STAGE_VENTA_ACUERDO=201004
KOMMO_STAGE_VENTA_COMPLETADA=201005
KOMMO_STAGE_VENTA_PERDIDO=201006

# ------------------------------------------------------------
# Kommo — IDs de etapas del pipeline PERMUTA
# ------------------------------------------------------------
KOMMO_STAGE_PERMUTA_CONSULTA=202001
KOMMO_STAGE_PERMUTA_VALUACION=202002
KOMMO_STAGE_PERMUTA_PROPUESTA=202003
KOMMO_STAGE_PERMUTA_ACUERDO=202004
KOMMO_STAGE_PERMUTA_REALIZADA=202005
KOMMO_STAGE_PERMUTA_PERDIDO=202006

# ------------------------------------------------------------
# Kommo — IDs de etapas del pipeline REPARACION
# ------------------------------------------------------------
KOMMO_STAGE_REPARACION_CONSULTA=203001
KOMMO_STAGE_REPARACION_DIAGNOSTICO=203002
KOMMO_STAGE_REPARACION_PRESUPUESTO=203003
KOMMO_STAGE_REPARACION_INGRESO=203004
KOMMO_STAGE_REPARACION_EN_PROCESO=203005
KOMMO_STAGE_REPARACION_LISTO=203006
KOMMO_STAGE_REPARACION_ENTREGADO=203007
KOMMO_STAGE_REPARACION_CANCELADO=203008

# ------------------------------------------------------------
# Kommo — IDs de etapas del pipeline GARANTIA
# ------------------------------------------------------------
KOMMO_STAGE_GARANTIA_RECLAMO=204001
KOMMO_STAGE_GARANTIA_VERIFICACION=204002
KOMMO_STAGE_GARANTIA_DIAGNOSTICO=204003
KOMMO_STAGE_GARANTIA_RESOLUCION=204004
KOMMO_STAGE_GARANTIA_RESUELTO=204005
KOMMO_STAGE_GARANTIA_DENEGADO=204006

# ------------------------------------------------------------
# Kommo — IDs de etapas del pipeline ACCESORIOS
# ------------------------------------------------------------
KOMMO_STAGE_ACCESORIOS_CONSULTA=205001
KOMMO_STAGE_ACCESORIOS_PROPUESTA=205002
KOMMO_STAGE_ACCESORIOS_VENDIDO=205003
KOMMO_STAGE_ACCESORIOS_PERDIDO=205004

# ------------------------------------------------------------
# Kommo — IDs de campos personalizados
# Crear los campos en Kommo → Settings → Custom fields → Leads
# Obtener los IDs con: GET /api/v4/leads/custom_fields
# Si un campo no está configurado (valor vacío o 0), ese campo no se actualiza
# ------------------------------------------------------------
# Score del lead [0–100] — tipo: Número
KOMMO_FIELD_SCORE_ID=300001
# Temperatura — tipo: Lista (opciones: caliente, tibio, frio, no_calificado)
KOMMO_FIELD_TEMPERATURA_ID=300002
# Tipo de consulta — tipo: Lista (opciones: compra, venta, permuta, reparacion, garantia, accesorios)
KOMMO_FIELD_TIPO_CONSULTA_ID=300003
# Requiere humano — tipo: Checkbox
KOMMO_FIELD_REQUIERE_HUMANO_ID=300004
# Intención detectada — tipo: Texto
KOMMO_FIELD_INTENCION_ID=300005
# Canal de entrada — tipo: Lista (opciones: whatsapp, instagram, facebook, web)
KOMMO_FIELD_CANAL_ENTRADA_ID=300006
# Última acción del agente — tipo: Texto
KOMMO_FIELD_ACCION_VENTA_ID=300007
