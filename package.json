{
  "name": "vendedor-ia",
  "version": "0.1.0",
  "description": "Agente de ventas inteligente para e-commerce de tecnología",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --env-file .env --watch --import tsx/esm src/api/routes.ts",
    "build": "echo \"sin build — se corre con tsx\"",
    "start": "node --import tsx/esm src/api/routes.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "import-history": "tsx scripts/import-history.ts",
    "import-kommo-history": "node --env-file .env --import tsx/esm scripts/import-kommo-history.ts",
    "serve": "bash -c 'lsof -ti:${PORT:-3000} | xargs kill -9 2>/dev/null; sleep 1; exec node --env-file .env --import tsx/esm src/api/routes.ts'",
    "start:dist": "node dist/api/routes.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/genai": "^2.19.0",
    "@supabase/supabase-js": "^2.45.0",
    "@xenova/transformers": "^2.17.2",
    "node-cron": "^3.0.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
